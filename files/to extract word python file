import re

INPUT_FILE = "response.txt"
OUTPUT_FILE = "datasource_output.txt"

# 🔹 Italian → English dictionary
translation_dict = {
    "evento": "event",
    "eventi": "events",
    "partecipante": "participant",
    "partecipanti": "participants",
    "cliente": "customer",
    "clienti": "customers",
    "anagrafica": "profile",
    "utente": "user",
    "utenti": "users",
    "documento": "document",
    "documenti": "documents",
    "pagamento": "payment",
    "pagamenti": "payments",
    "ordine": "order",
    "ordini": "orders"
}

# 🔹 Extract DataSources
def extract_datasources(text):
    pattern = r'\b[a-zA-Z]+datasource\b'
    return list(set(re.findall(pattern, text, re.IGNORECASE)))

# 🔹 Get base word
def get_base_word(ds_name):
    match = re.match(r"(.*?)(datasource)", ds_name, re.IGNORECASE)
    return match.group(1).lower() if match else ds_name.lower()

# 🔹 Translate
def translate(word):
    return translation_dict.get(word, None)

# 🔹 Main
def process():
    with open(INPUT_FILE, "r", encoding="utf-8") as f:
        content = f.read()

    datasources = extract_datasources(content)

    with open(OUTPUT_FILE, "w", encoding="utf-8") as f:
        for ds in datasources:
            base = get_base_word(ds)
            english = translate(base)

            if english:
                eng_ds = english + "DataSource"
            else:
                eng_ds = "UNKNOWN"

            f.write(f"{ds}  -->  {eng_ds}\n")

    print(f"[+] Done! Results saved in {OUTPUT_FILE}")

if __name__ == "__main__":
    process()
