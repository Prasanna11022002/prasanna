import re

INPUT_FILE = "response.txt"
OUTPUT_FILE = "datasources.txt"

def extract_datasources(text):
    # Match words ending with DataSource (case-insensitive)
    pattern = r'\b[a-zA-Z]+datasource\b'
    matches = re.findall(pattern, text, re.IGNORECASE)
    
    # Remove duplicates and normalize
    unique = sorted(set(matches), key=str.lower)
    return unique

def main():
    with open(INPUT_FILE, "r", encoding="utf-8") as f:
        content = f.read()

    datasources = extract_datasources(content)

    with open(OUTPUT_FILE, "w", encoding="utf-8") as f:
        for ds in datasources:
            f.write(ds + "\n")

    print(f"[+] Extracted {len(datasources)} DataSources → saved to {OUTPUT_FILE}")

if __name__ == "__main__":
    main()
